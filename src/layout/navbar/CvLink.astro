---
import { personal } from '@data/personal';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={personal.cvPath}
  aria-label="Télécharger le CV de Thomas ROBERT au format PDF"
  download
  class:list={[
    'text-muted-foreground hover:bg-muted hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-ring/50 rounded-md px-3 py-2 text-sm font-medium transition-colors outline-none focus-visible:ring-[3px]',
    className,
  ]}
  >CV
</a>

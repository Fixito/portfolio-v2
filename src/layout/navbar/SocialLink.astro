---
import { Icon } from 'astro-icon/components';

import type { SocialLink } from '@data/types';

type Props = SocialLink;

const { url, icon, title } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Consulter mon profil ${title} (ouvre dans un nouvel onglet)`}
  class="text-muted-foreground hover:text-foreground focus-visible:ring-ring focus-visible:ring-offset-background rounded-md p-2 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
>
  <Icon name={icon} class="size-6" aria-hidden="true" />
</a>

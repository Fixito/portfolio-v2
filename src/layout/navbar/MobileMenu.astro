---
import { Icon } from 'astro-icon/components';

import { navlinks } from './links';

import CvLink from './CvLink.astro';
---

<div class="flex items-center sm:hidden">
  <!-- Mobile menu button -->
  <button
    type="button"
    aria-controls="mobile-menu"
    aria-expanded="false"
    aria-label="Ouvrir le menu de navigation mobile"
    data-label-open="Ouvrir le menu de navigation mobile"
    data-label-close="Fermer le menu de navigation mobile"
    class="text-muted-foreground hover:bg-muted hover:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring relative inline-flex items-center justify-center rounded-md p-2 outline-none focus-visible:ring-[3px]"
  >
    <span class="absolute -inset-0.5"></span>
    <span class="sr-only">Ouvrir le menu principal</span>
    <Icon
      name="ri:menu-fill"
      aria-hidden="true"
      class="text-muted-foreground block size-6"
      id="menu-icon-closed"
    />
    <Icon
      name="ri:close-fill"
      aria-hidden="true"
      class="text-muted-foreground hidden size-6"
      id="menu-icon-open"
    />
  </button>
</div>

<div
  id="mobile-menu"
  hidden
  class="border-border bg-background fixed top-16 right-0 left-0 z-40 space-y-1 border-b px-4 pt-2 pb-3 shadow-lg backdrop-blur-md"
>
  {
    navlinks.map(({ href, text }) => (
      <a
        href={href}
        aria-label={`Naviguer vers la section ${text.toLowerCase()}`}
        data-mobile-nav-link
        class="text-muted-foreground hover:text-foreground block rounded-md px-3 py-2 text-base font-medium transition-colors duration-150"
      >
        {text}
      </a>
    ))
  }
  <CvLink data-mobile-nav-link class="block" />
</div>

<script>
  import { scrollToSection } from '../../scripts/smooth-scroll';
  import { prefersReducedMotion } from '../../scripts/animations';

  const panel = document.getElementById('mobile-menu')!;
  const mobileMenuButton = document.querySelector("button[aria-controls='mobile-menu']")!;
  const mobileNavlinks = document.querySelectorAll('[data-mobile-nav-link]');
  const menuIconClosed = document.querySelector('#menu-icon-closed')!;
  const menuIconOpen = document.querySelector('#menu-icon-open')!;
  const header = document.getElementById('site-header')!;

  document.body.appendChild(panel);

  let isAnimating = false;

  const setIconState = (isOpen: boolean) => {
    if (isOpen) {
      menuIconClosed.classList.add('hidden');
      menuIconOpen.classList.remove('hidden');
    } else {
      menuIconClosed.classList.remove('hidden');
      menuIconOpen.classList.add('hidden');
    }
  };

  const openMenu = () => {
    if (isAnimating || header.dataset.menuOpen === 'true') return;
    isAnimating = true;

    panel.classList.add('starting-style');
    panel.hidden = false;

    // Force a reflow to ensure the starting-style class is applied before removing it
    void panel.offsetHeight;

    requestAnimationFrame(() => {
      panel.classList.remove('starting-style');
    });

    header.dataset.menuOpen = 'true';
    mobileMenuButton.setAttribute('aria-expanded', 'true');
    mobileMenuButton.setAttribute('aria-label', mobileMenuButton.getAttribute('data-label-close')!);
    setIconState(true);

    isAnimating = false;
  };

  const closeMenu = () => {
    if (isAnimating || header.dataset.menuOpen !== 'true') return;
    isAnimating = true;

    mobileMenuButton.setAttribute('aria-expanded', 'false');
    mobileMenuButton.setAttribute('aria-label', mobileMenuButton.getAttribute('data-label-open')!);
    setIconState(false);
    delete header.dataset.menuOpen;

    const finishClose = () => {
      panel.hidden = true;
      panel.classList.remove('is-closing');
      isAnimating = false;
    };

    panel.classList.add('is-closing');

    if (prefersReducedMotion()) {
      finishClose();
    } else {
      let timeoutId: number | null = null;
      const onTransitionEnd = () => {
        if (timeoutId !== null) {
          clearTimeout(timeoutId);
        }
        finishClose();
      };

      panel.addEventListener('transitionend', onTransitionEnd, { once: true });

      timeoutId = window.setTimeout(() => {
        panel.removeEventListener('transitionend', onTransitionEnd);
        finishClose();
      }, 200);
    }
  };

  mobileMenuButton.addEventListener('click', () => {
    if (panel.hidden) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  mobileNavlinks.forEach((navLink) => {
    navLink.addEventListener('click', (e) => {
      const href = (e.currentTarget as HTMLElement).getAttribute('href');

      if (href?.startsWith('#')) {
        e.preventDefault();
        const section = document.querySelector(href) as HTMLElement | null;
        if (section) scrollToSection(section);
      }
      closeMenu();
    });
  });
</script>

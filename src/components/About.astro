---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import { personal } from '@data/personal';
import heroImage from '@assets/images/me.webp';
---

<section id="about" class="flex min-h-[calc(100vh-64px)] items-center py-24">
  <div class="container lg:grid lg:grid-cols-2 lg:items-center lg:gap-16">
    <div class="reveal">
      <h1
        class="text-foreground text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
      >
        Développeur<br />Full-Stack<br />React & Node.js
      </h1>

      <p class="text-muted-foreground mt-6 max-w-2xl text-lg/8">
        Je développe des applications web avec TypeScript, React et Node.js, en
        combinant architecture propre, performance et expérience utilisateur.
      </p>

      <p class="text-muted-foreground mt-2 text-lg/8">
        Développement et transmission depuis 2020.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a
          href={`mailto:${personal.email}`}
          aria-label={`Envoyer un email à ${personal.name} pour travailler ensemble`}
          class="cta-primary bg-primary hover:bg-primary-accent focus-visible:ring-ring focus-visible:ring-offset-background inline-flex items-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Travailler avec moi
        </a>

        <a
          href="#projects"
          aria-label="Naviguer vers la section de mes projets"
          class="group text-muted-foreground hover:text-foreground focus-visible:ring-ring focus-visible:ring-offset-background inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Voir mes projets
          <Icon
            name="ri:arrow-right-line"
            class="h-4 w-4 transition-transform duration-150 group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>

    <!-- Image -->
    <div class="reveal mt-14 lg:mt-0 lg:justify-self-end">
      <Image
        class="block w-full max-w-sm rounded-2xl object-cover"
        src={heroImage}
        alt={`Photo de ${personal.name}.`}
        width={400}
        priority
      />
    </div>
  </div>
</section>

<style>
  .cta-primary {
    transition:
      background-color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .cta-primary:active {
    transform: scale(0.97);
  }
</style>

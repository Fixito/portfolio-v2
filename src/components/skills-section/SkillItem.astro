---
import { Icon } from 'astro-icon/components';

interface Props {
  skill: string;
}
const { skill } = Astro.props;
---

<div
  class="reveal border-border text-foreground bg-background flex w-full items-center gap-3 rounded-md border px-4 py-3 text-sm font-medium shadow transition-colors duration-150"
>
  <Icon
    name="heroicons:check-badge-solid"
    class="text-primary size-4 shrink-0"
    aria-hidden="true"
  />
  {skill}
</div>

---
import type { SectionMeta } from '@data/types';

type Props = SectionMeta;

const { title, description } = Astro.props;
---

<div class="reveal">
  <h2 class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl">
    {title}
  </h2>
  <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-base/7 text-balance">
    {description}
  </p>
</div>
